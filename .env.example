# ---------- Anthropic (servidor) ----------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# claude-opus-5 (padrão, mais preciso) | claude-sonnet-5 (~60% mais barato, ótimo para OCR)
ANTHROPIC_MODEL=claude-opus-5

# ---------- Supabase ----------
# Project Settings → API → Project URL / anon public
# (o servidor age como o usuário logado — não precisa da service_role key)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...anon...

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...anon...

# ---------- Dev local ----------
API_PORT=8787
RECEITAS_BUCKET=receitas

# ---------- Seed (opcional — `npm run seed`) ----------
SEED_EMAIL=
SEED_PASSWORD=
